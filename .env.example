# Ejemplo de archivo de configuración
# Copiar este archivo a .env y completar con los valores reales

# URL base de la API de Business Central
BUSINESS_CENTRAL_BASE_URL=https://tu-instancia.businesscentral.dynamics.com

# Listados OData (opcional; por defecto ListaIncidencias y ListaOrdenes en la empresa configurada)
# BUSINESS_CENTRAL_ENDPOINT_LISTA_INCIDENCIAS=/powerbi/ODataV4/Company('{company}')/ListaIncidencias
# BUSINESS_CENTRAL_ENDPOINT_LISTA_ORDENES=/powerbi/ODataV4/Company('{company}')/ListaOrdenes

# Calendario mantenimiento , misma OData para emplaz y recursos)
# BUSINESS_CENTRAL_ENDPOINT_LISTADO_MANTENIMIENTO=/powerbi/ODataV4/GtaskMalla_ListadoMantenimientoEmplaz
# BUSINESS_CENTRAL_PROCEDURE_MANTENIMIENTO_EMPLAZ=ListadoMantenimientoEmplaz
# BUSINESS_CENTRAL_PROCEDURE_MANTENIMIENTO_RECURSO=ListadoMantenimientoRecurso
# Opcional: solo si recursos usa otra publicación OData (por defecto = la misma URL que emplazamientos)
# BUSINESS_CENTRAL_ENDPOINT_LISTADO_MANTENIMIENTO_RECURSO=

# Clave de API para autenticación
BUSINESS_CENTRAL_API_KEY=tu-api-key-aqui

# Subida de imágenes (mismo servicio que app Incidencias)
# BASE64_API_SAVE_URL=https://base64-api.deploy.malla.es/save

# Usuarios administradores (solo ellos pueden asignar permisos). Separados por coma.
# ADMINISTRADORES=andreuserra,llorençllompart

# URL de base de datos (opcional, para almacenamiento local)
# DATABASE_URL=sqlite:///gmalla.db

# URL pública del calendario GMalla (enlace en WhatsApp al asignar incidencia: ?id=Nº)
# GMALLA_PUBLIC_APP_URL=https://taller.malla.es

# SSO portal Malla (mismo valor que en apps.malla.es)
# MALLA_SSO_SECRET=genera-un-secreto-largo-compartido
# APPDESKTOP_URL=https://apps.malla.es
# SSO_LOGIN_ENABLED=true

# App Mantenimiento (botón «Mantenimiento» en la barra de GMalla)
# MANTENIMIENTO_APP_URL=http://127.0.0.1:5021

# API WhatsApp (proyecto Apiwhats). Ej.: http://127.0.0.1:5091 — vacío = sin notificaciones
# API_WHATS_URL=http://127.0.0.1:5091
# Secreto si Apiwhats tiene API_AUTH_REQUIRED o API_SECRET_TOKEN (cabecera X-API-Key)
# API_WHATS_SECRET_TOKEN=
# WHATSAPP_NOTIFICAR_ASIGNACION=true
# Tras /enviar OK, registrar en BC (postRespuestaWhatsApp) con id_mensaje + id_registro + id_tabla
# WHATSAPP_NOTIFICAR_BC=true
# Aviso masivo «Taller»: segundos entre cada envío (0 = sin pausa) y rotar encabezado del mensaje
# WHATSAPP_TALLER_INTERVALO_SEG=3
# WHATSAPP_TALLER_VARIAR_TEXTO=true
# La decisión plantilla vs texto libre la aplica Apiwhats (.env). GMalla envía Mensaje y NombreOperario ({{1}} en plantillas Meta).
# BUSINESS_CENTRAL_ENDPOINT_POST_RESPUESTA_WHATSAPP=/powerbi/ODataV4/GtaskMalla_postRespuestaWhatsApp

# Departamento GTask «Taller» (ObjectId) para el botón «Avisar Taller (WhatsApp)»
# GTASK_DEPARTAMENTO_TALLER_ID=6536459ad826e80019f16725

# Depuración: GET http://localhost:5000/api/diagnostico/whatsapp-bc (ajusta host/puerto)

