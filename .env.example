# Ejemplo de archivo de configuración
# Copiar este archivo a .env y completar con los valores reales

# URL base de la API de Business Central
BUSINESS_CENTRAL_BASE_URL=https://tu-instancia.businesscentral.dynamics.com

# Clave de API para autenticación
BUSINESS_CENTRAL_API_KEY=tu-api-key-aqui

# Usuarios administradores (solo ellos pueden asignar permisos). Separados por coma.
# ADMINISTRADORES=andreuserra,llorençllompart

# URL de base de datos (opcional, para almacenamiento local)
# DATABASE_URL=sqlite:///gmalla.db

# API WhatsApp (proyecto Apiwhats). Ej.: http://127.0.0.1:5091 — vacío = sin notificaciones
# API_WHATS_URL=http://127.0.0.1:5091
# Secreto si Apiwhats tiene API_AUTH_REQUIRED o API_SECRET_TOKEN (cabecera X-API-Key)
# API_WHATS_SECRET_TOKEN=
# WHATSAPP_NOTIFICAR_ASIGNACION=true
# Tras /enviar OK, registrar en BC (postRespuestaWhatsApp) con id_mensaje + id_incidencia
# WHATSAPP_NOTIFICAR_BC=true
# BUSINESS_CENTRAL_ENDPOINT_POST_RESPUESTA_WHATSAPP=/powerbi/ODataV4/GtaskMalla_postRespuestaWhatsApp

# Departamento GTask «Taller» (ObjectId) para el botón «Avisar Taller (WhatsApp)»
# GTASK_DEPARTAMENTO_TALLER_ID=6536459ad826e80019f16725

# Depuración: GET http://localhost:5000/api/diagnostico/whatsapp-bc (ajusta host/puerto)

